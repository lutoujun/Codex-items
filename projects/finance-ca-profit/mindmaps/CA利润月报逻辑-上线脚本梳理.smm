                        "children": []
                    }
                ]
            },
            {
                "data": {
                    "text": "<p>\u6a21\u5757\u56db\uff5c\u5feb\u9012\u8d39\u4e0e\u4ea7\u54c1\u6210\u672c\u5f52\u96c6</p>",
                    "uid": "a0000000-0000-4000-8000-000000000050",
                    "expand": true,
                    "richText": true,
                    "isActive": false
                },
                "children": [
                    {
                        "data": {
                            "text": "<p>tmp02_shipping_payment\uff1a\u8d26\u5355\u4fa7\u5feb\u9012\u8d39\uff1btmp02_shipping_order\uff1a\u8ba2\u5355\u4fa7\u5feb\u9012\u8d39\u53ca\u4ea7\u54c1\u6210\u672c</p>",
                            "uid": "a0000000-0000-4000-8000-000000000051",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6210\u672c\u9879\uff1aDDP\u3001FOB\u3001\u6d77\u8fd0\u8d39\u3001\u5934\u7a0b\u7269\u6d41\u8d39\u3001\u4ea7\u54c1\u5173\u7a0e\u3001\u5165\u5e93\u8d39\u3001\u5feb\u9012\u8d39</p>",
                            "uid": "a0000000-0000-4000-8000-000000000052",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>tmp08\uff1a\u5339\u914d\u8d26\u5355\u4e0e\u8ba2\u5355\uff0c\u8bc6\u522b\u672c\u671f/\u5386\u53f2/\u591a\u4f59\u5feb\u9012\u6570\u636e\uff0c\u5e76\u533a\u5206\u8865\u53d1\u4e0e\u975e\u8865\u53d1</p>",
                            "uid": "a0000000-0000-4000-8000-000000000053",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>tmp11\uff1a\u7ed3\u5408\u6c604\u3001\u6c605\u5b8c\u6210\u975e\u8865\u53d1\u4e0e\u8865\u53d1\u7684\u5386\u53f2\u5feb\u9012\u8d39/\u4ea7\u54c1\u6210\u672c\u5f52\u96c6</p>",
                            "uid": "a0000000-0000-4000-8000-000000000054",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    }
                ]
            },
            {
                "data": {
                    "text": "<p>\u6a21\u5757\u4e94\uff5c\u5229\u6da6\u53e3\u5f84\u6c47\u603b</p>",
                    "uid": "a0000000-0000-4000-8000-000000000060",
                    "expand": true,
                    "richText": true,
                    "isActive": false
                },
                "children": [
                    {
                        "data": {
                            "text": "<p>tmp09\uff1a\u9500\u552e\u3001\u8d26\u671f\u8d39\u3001\u4f63\u91d1\u3001\u4fc3\u9500\u3001\u9000\u6b3e\u3001\u8865\u8d34\u6536\u5165</p>",
                            "uid": "a0000000-0000-4000-8000-000000000061",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>tmp99\uff1a\u6309\u5e97\u94fa \u00d7 SellerSKU \u00d7 \u6708\u4efd\u62fc\u63a5\u6536\u5165\u3001\u8425\u9500\u8d39\u7528\u3001\u6210\u672c\u3001\u552e\u540e\u4e0e\u7ef4\u5ea6\u4fe1\u606f</p>",
                            "uid": "a0000000-0000-4000-8000-000000000062",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u4e1a\u7ee9GMV = \u9500\u552e\u91d1\u989d \u2212 \u4fc3\u9500\u91d1\u989d</p>",
                            "uid": "a0000000-0000-4000-8000-000000000063",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u8425\u9500\u8d39\u7528\u5408\u8ba1 = \u56fa\u5b9a\u8425\u9500\u8d39 + \u5e7f\u544a\u8d39</p>",
                            "uid": "a0000000-0000-4000-8000-000000000064",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u5e73\u53f0\u4f63\u91d1\u5408\u8ba1 = \u4f63\u91d1 \u2212 \u4f63\u91d1\u9000\u56de</p>",
                            "uid": "a0000000-0000-4000-8000-00000000006c",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6d3e\u9001\u8d39/\u64cd\u4f5c\u8d39\u5408\u8ba1 = \u51fa\u5e93\u5904\u7406\u8d39 + \u5c3e\u7a0b\u5feb\u9012\u8d39</p>",
                            "uid": "a0000000-0000-4000-8000-000000000065",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u552e\u540e\u603b\u652f\u51fa = \u8865\u53d1\u4ea7\u54c1\u6210\u672c + \u8865\u53d1\u8fd0\u8d39 + \u5e73\u53f0\u9000\u6b3e</p>",
                            "uid": "a0000000-0000-4000-8000-00000000006d",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u5229\u6da6 = \u4e1a\u7ee9GMV \u2212 \u8425\u9500\u8d39\u7528\u5408\u8ba1 + \u8865\u8d34\u6536\u5165 \u2212 \u6d3e\u9001\u8d39/\u64cd\u4f5c\u8d39\u5408\u8ba1 \u2212 \u8d26\u671f\u8d39 \u2212 \u5e73\u53f0\u4f63\u91d1\u5408\u8ba1 \u2212 \u552e\u540e\u603b\u652f\u51fa \u2212 \u5e97\u94fa\u79df\u91d1 \u2212 \u4ea7\u54c1\u6210\u672c\u5408\u8ba1 + \u7d22\u8d54 \u2212 \u5237\u5355\u8d39\u7528</p>",
                            "uid": "a0000000-0000-4000-8000-000000000066",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u5229\u6da6\u7387 = \u5229\u6da6 \u00f7 \u4e1a\u7ee9GMV</p>",
                            "uid": "a0000000-0000-4000-8000-000000000067",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u4ea7\u54c1\u6210\u672c\u5408\u8ba1 = DDP\u6210\u672c</p>",
                            "uid": "a0000000-0000-4000-8000-000000000068",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>DDP\u6210\u672c = FOB\u6210\u672c + \u6d77\u8fd0\u8d39 + \u4ea7\u54c1\u5173\u7a0e + \u5934\u7a0b\u7269\u6d41\u8d39 + \u5165\u5e93\u8d39</p>",
                            "uid": "10b6c58f-ce7a-4aef-8186-61a45b28ce87",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u4e94\u9879\u6210\u672c\u901a\u8fc7 DDP \u95f4\u63a5\u8fdb\u5165\u5229\u6da6\uff0c\u4e0d\u80fd\u518d\u91cd\u590d\u6263\u51cf</p>",
                            "uid": "a0000000-0000-4000-8000-00000000006e",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6570\u636e\u6838\u9a8c\uff1aDDP\u4e0e\u4e94\u9879\u6210\u672c\u5728\u6708\u5ea6\u6c47\u603b\u4e0a\u57fa\u672c\u4e00\u81f4\uff1b\u4f46\u539f\u59cb\u6210\u672c\u8868\u5df2\u5b58\u5728\u975e\u96f6\u5dee\u989d\uff0c\u4e0d\u662f\u4e0b\u6e38\u4fdd\u7559\u5c0f\u6570\u9020\u6210</p>",
                            "uid": "a0000000-0000-4000-8000-000000000069",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": [
                            {
                                "data": {
                                    "text": "<p>\u5df2\u6838\u9a8c\u539f\u59cb\u8868 jamf_dis.upload_bi_outbound_cost_sheet_di\uff1a2026-06 \u7684 SHX1539-GR\uff0cDDP=99.6301\uff0c\u4e94\u9879\u6210\u672c\u548c=98.8657\uff0c\u5dee\u989d=0.7644</p>",
                                    "uid": "a0000000-0000-4000-8000-00000000006a",
                                    "expand": true,
                                    "richText": true,
                                    "isActive": false
                                },
                                "children": []
                            },
                            {
                                "data": {
                                    "text": "<p>\u7ed3\u679c\u8868\u6700\u5927\u5dee\u989d 6.1152 = \u539f\u59cb\u5dee\u989d 0.7644 \u00d7 8\uff0c\u7cfb\u8ba2\u5355/\u5305\u88f9\u5f52\u96c6\u653e\u5927\uff1b\u5e94\u4fee\u6b63\u539f\u59cb\u6210\u672c\u6216\u660e\u786e\u65b0\u589e\u6b8b\u5dee\u6210\u672c\u9879</p>",
                                    "uid": "a0000000-0000-4000-8000-00000000006b",
                                    "expand": true,
                                    "richText": true,
                                    "isActive": false
                                },
                                "children": []
                            }
                        ]
                    }
                ]
            },
            {
                "data": {
                    "text": "<p>\u6a21\u5757\u516d\uff5c\u6700\u7ec8\u7ed3\u679c\u8868\u4e0e\u5ba1\u8ba1\u70b9</p>",
                    "uid": "a0000000-0000-4000-8000-000000000070",
                    "expand": true,
                    "richText": true,
                    "isActive": false
                },
                "children": [
                    {
                        "data": {
                            "text": "<p>\u76ee\u6807\u8868\uff1ajamf_ads.ads_bi_finance_ca_profit_month_info</p>",
                            "uid": "a0000000-0000-4000-8000-000000000071",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u7ef4\u5ea6\uff1a\u8d22\u5e74\u3001\u8d22\u5b63\u3001\u7edf\u8ba1\u6708\u3001\u5e97\u94fa\u7c7b\u578b\u3001\u5e97\u94fa\u3001SellerSKU\u3001MSKU\u3001\u5206\u7c7b\u3001\u4ea7\u54c1\u7b49\u7ea7\u3001\u8fd0\u8425\u4eba\u5458</p>",
                            "uid": "a0000000-0000-4000-8000-000000000072",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u5199\u5165\u524d\u5220\u9664\u540c stat_month \u6570\u636e\uff0c\u518d\u5199\u5165\u672c\u6708\u7ed3\u679c\uff1b\u8d44\u6e90\u6c60\u811a\u672c\u7ef4\u62a4\u8de8\u6708\u53ef\u8ffd\u6eaf\u6570\u636e</p>",
                            "uid": "a0000000-0000-4000-8000-000000000073",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    }
                ]
            }
        ]
