                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u4e3b\u7c92\u5ea6\uff1a\u5e97\u94fa\u4ee3\u7801 \u00d7 SellerSKU\u4ee3\u7801 \u00d7 \u7edf\u8ba1\u6708\u4efd</p>",
