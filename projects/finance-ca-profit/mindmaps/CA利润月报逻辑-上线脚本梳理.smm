                        "children": []
                    }
                ]
            },
            {
                "data": {
                    "text": "<p>\u6a21\u5757\u4e8c\uff5c\u8d44\u6e90\u6c60\u7ef4\u62a4\uff08\u72ec\u7acb resource_pool \u811a\u672c\uff09</p>",
                    "uid": "a0000000-0000-4000-8000-000000000030",
                    "expand": true,
                    "richText": true,
                    "isActive": false
                },
                "children": [
                    {
                        "data": {
                            "text": "<p>\u6c601\uff1a\u6b63\u5e38\u8ba2\u5355\u5386\u53f2\u6c60\uff5c\u5e97\u94fa + SellerSKU + \u5e73\u53f0\u8ba2\u5355\u53f7\uff1b\u4fdd\u7559\u672a\u56de\u6b3e\u8ba2\u5355\u7684\u9884\u4f30\u8d26\u671f\u8d39/\u4f63\u91d1</p>",
                            "uid": "a0000000-0000-4000-8000-000000000031",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6c602\uff1a\u6b63\u5e38\u8ba2\u5355\u5386\u53f2\u6c60\uff5c\u5e97\u94fa + SellerSKU\uff1b\u7528\u4e8e\u4fc3\u9500\u3001\u5e7f\u544a\u7b49\u8de8\u671f\u8c03\u6574</p>",
                            "uid": "a0000000-0000-4000-8000-000000000032",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6c603\uff1a\u5f02\u5e38\u8ba2\u5355\u5386\u53f2\u6c60\uff5c\u5e97\u94fa + SellerSKU + \u5e73\u53f0\u8ba2\u5355\u53f7\uff1b\u8bb0\u5f55\u5f02\u5e38\u5904\u7406\u72b6\u6001</p>",
                            "uid": "a0000000-0000-4000-8000-000000000033",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6c604\uff1a\u975e\u8865\u53d1\u5feb\u9012\u8d39\u5386\u53f2\u6c60\uff5c\u5e97\u94fa + \u5355\u7bb1SKU + SellerSKU + \u5e73\u53f0\u8ba2\u5355\u53f7 + \u5ba2\u6237\u5355\u53f7</p>",
                            "uid": "a0000000-0000-4000-8000-000000000034",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6c605\uff1a\u8865\u53d1\u5feb\u9012\u8d39\u5386\u53f2\u6c60\uff5c\u4e0e\u6c604\u540c\u7c92\u5ea6\uff0c\u5355\u72ec\u6c89\u6dc0\u8865\u53d1\u8ba2\u5355\u6210\u672c</p>",
                            "uid": "a0000000-0000-4000-8000-000000000035",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u6bcf\u4e2a\u8d44\u6e90\u6c60\u5747\u7ef4\u62a4\u5f53\u671f\u6c60\u4e0e\u5907\u4efd\u6c60\uff1b\u4e3b\u811a\u672c\u8bfb\u53d6\u5386\u53f2\u6570\u636e\u5b8c\u6210\u8de8\u671f\u5dee\u5f02\u5f52\u5c5e</p>",
                            "uid": "a0000000-0000-4000-8000-000000000036",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>\u671f\u521d\u6570\u636e\uff1d\u5207\u6362\u6708\u4e4b\u524d\u5c1a\u672a\u95ed\u73af\u7684\u8d44\u6e90\u6c60\u8bb0\u5f55\uff0c\u4e0d\u662f\u7ed3\u679c\u8868\u4e2d\u7684\u5355\u72ec\u671f\u521d\u4f59\u989d</p>",
                            "uid": "a0000000-0000-4000-8000-000000000037",
                            "expand": true,
                            "richText": true,
                            "isActive": false
                        },
                        "children": [
                            {
                                "data": {
                                    "text": "<p>\u4e3b\u811a\u672c\u8bfb\u53d6\uff1a\u6c601\u672a\u56de\u6b3e\u8ba2\u5355\u3001\u6c603\u672a\u5904\u7406\u5f02\u5e38\u8ba2\u5355\u3001\u6c604/\u6c605\u672a\u56de\u6b3e\u5feb\u9012\u8d26\u5355\uff0c\u4ee5\u53ca\u6c602\u524d\u4e24\u6708\u4fc3\u9500\u8c03\u6574\u6570\u636e</p>",
                                    "uid": "a0000000-0000-4000-8000-000000000038",
                                    "expand": true,
                                    "richText": true,
                                    "isActive": false
                                },
                                "children": []
                            },
                            {
                                "data": {
                                    "text": "<p>\u63a8\u8350\u521d\u59cb\u5316\uff1a\u4ece\u6700\u65e9\u9700\u8981\u8ffd\u6eaf\u7684\u6708\u4efd\u5f00\u59cb\uff0c\u6309\u6708\u4f9d\u6b21\u8fd0\u884c\u4e3b\u811a\u672c\u4e0e\u8d44\u6e90\u6c60\u811a\u672c\uff0c\u56de\u704c\u5f62\u6210\u671f\u521d\u8d44\u6e90\u6c60</p>",
                                    "uid": "a0000000-0000-4000-8000-000000000039",
                                    "expand": true,
                                    "richText": true,
                                    "isActive": false
                                },
                                "children": []
                            },
                            {
                                "data": {
                                    "text": "<p>\u65e0\u6cd5\u56de\u704c\u65f6\uff1a\u4ee5\u5207\u6362\u6708\u524d\u4e00\u65e5\u4e3a\u65f6\u70b9\uff0c\u6309\u5404\u6c60\u4e1a\u52a1\u4e3b\u952e\u704c\u5165\u672a\u56de\u6b3e\u3001\u672a\u5904\u7406\u3001\u672a\u5339\u914d\u4e8b\u9879\uff1b\u9700\u4fdd\u7559 stat_month\u3001\u72b6\u6001\u6807\u8bb0\u53ca\u91d1\u989d\u5b57\u6bb5</p>",
                                    "uid": "a0000000-0000-4000-8000-00000000003a",
                                    "expand": true,
                                    "richText": true,
                                    "isActive": false
                                },
                                "children": []
                            },
                            {
                                "data": {
                                    "text": "<p>\u4e0d\u53ef\u628a\u5386\u53f2\u5df2\u95ed\u73af\u4e8b\u9879\u4f5c\u4e3a\u671f\u521d\u704c\u5165\uff0c\u5426\u5219\u56de\u6b3e\u3001\u5feb\u9012\u8d39\u6216\u5f02\u5e38\u8ba2\u5355\u4f1a\u5728\u5207\u6362\u6708\u91cd\u590d\u5f52\u96c6</p>",
