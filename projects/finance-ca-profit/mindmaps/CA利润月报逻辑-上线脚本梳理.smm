                            "isActive": false
                        },
                        "children": []
                    },
                    {
                        "data": {
                            "text": "<p>tmp01_promot\uff1a\u8865\u5145\u4fc3\u9500\uff1btmp01_result\uff1a\u5f62\u6210\u6708\u5ea6\u6536\u5165\u8ba2\u5355\u660e\u7ec6</p>",
